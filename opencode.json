{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "lsp": {
    "css": {
      "command": ["vscode-css-language-server", "--stdio"],
      "extensions": [".css", ".scss", ".less"]
    },
    "html": {
      "command": ["vscode-html-language-server", "--stdio"],
      "extensions": [".html", ".htm"]
    },
    "json": {
      "command": ["vscode-json-language-server", "--stdio"],
      "extensions": [".json", ".jsonc"]
    },
    "templ": {
      "command": ["templ", "lsp"],
      "extensions": [".templ"]
    },
    "jsonnet": {
      "command": ["jsonnet-language-server"],
      "extensions": [".jsonnet", ".libsonnet"]
    },
    "java": {
      "command": [
        "bash",
        "-lc",
        "lombok=\"${LOMBOK_JAR:-$(ls \"$HOME\"/.m2/repository/org/projectlombok/lombok/*/lombok-*.jar 2>/dev/null | sort -V | tail -n 1)}\"; if [ -n \"$lombok\" ]; then exec jdtls --jvm-arg=\"-javaagent:$lombok\"; fi; exec jdtls"
      ],
      "extensions": [".java"]
    }
  },
  "mcp": {
    "servers": {
      "azure devops": {
        "type": "local",
        "command": [
          "/home/wayland/Projects/Source2Sea/az-mcp/.venv/bin/python",
          "/home/wayland/Projects/Source2Sea/az-mcp/azure_devops_work_item_mcp.py"
        ]
      }
    }
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "glob *", "effect": "allow" },
    { "action": "shell", "resource": "gofmt *", "effect": "allow" },
    { "action": "shell", "resource": "go test *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git branch --show-current", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl describe *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl get *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "/etc/profiles/per-user/wayland/bin/but *", "effect": "allow" },
    { "action": "shell", "resource": "but *", "effect": "allow" },
    { "action": "shell", "resource": "templ generate *", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "azure_devops_read_azure_devops_work_item", "resource": "*", "effect": "allow" },
    { "action": "list", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "ask" },
    { "action": "subagent", "resource": "explore", "effect": "allow" },
    { "action": "todowrite", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "question", "resource": "*", "effect": "allow" }
  ],
  "plugins": [
    "opencode-claude-auth@latest",
    "opencode-caveman",
    "open-plan-annotator@1.9.2",
    "kdco-notify"
  ]
}
